# Required by artifacts/refmap/vite.config.ts during local development and build.
PORT=22247
BASE_PATH=/

# Optional. Usually supplied by the command or runtime.
NODE_ENV=development

# Optional; only used by the separate API server's logger.
LOG_LEVEL=info

# Optional; only needed if using the unused Drizzle/PostgreSQL package or its tooling.
# RefMap itself does not connect to a database.
DATABASE_URL=postgresql://user:password@localhost:5432/refmap

# Do not set REPL_ID outside Replit. Its presence enables Replit-only Vite dev plugins.
# SESSION_SECRET is not used by the current project and is intentionally omitted.
